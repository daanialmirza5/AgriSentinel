# Copy to .env and adjust as needed. All values have safe defaults if unset.

# Where a trained agricultural weed/crop YOLO model would live.
# If this file does not exist, the app runs in "model unavailable" /
# generic-demo-model mode and clearly labels it as such.
AGRISENTINEL_MODEL_PATH=models/weed_crop_model.pt

# Directory for the small pretrained COCO demo model (auto-downloaded once).
AGRISENTINEL_MODELS_DIR=models

# Allow downloading a generic (non-agricultural) YOLO model to demonstrate
# the real inference pipeline end-to-end when no trained model is present.
# Set to "false" to disable network access entirely and only ever use the
# classical vegetation-heuristic fallback.
AGRISENTINEL_ALLOW_GENERIC_MODEL=true

# Where uploads/results/sample images and the SQLite DB are stored.
AGRISENTINEL_DATA_DIR=data

# Override the SQLAlchemy database URL (defaults to a local SQLite file).
# AGRISENTINEL_DATABASE_URL=sqlite:///data/agrisentinel.db

# Default confidence threshold for accepting a detection (0-1).
AGRISENTINEL_CONF_THRESHOLD=0.35
